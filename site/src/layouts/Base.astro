---
import { families, updated } from '../lib/data.js';
import { formatDay } from '../lib/forecast.js';
import Search from '../components/Search.astro';
import Icon from '../components/Icon.astro';

const { title, description, noindex = false, jsonLd = null, wide = false, hideSearch = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const short = (f) => (f.id === 'linux-kernel' ? 'Kernel' : f.id === 'linux-mint' ? 'Mint' : f.name);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%23111827'/><path d='M10 21 21 10M13 10h8v8' stroke='white' stroke-width='3' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <style is:global>
      :root {
        --bg: #ffffff; --soft: #f8fafc; --ink: #0f172a; --muted: #64748b; --faint: #94a3b8; --line: #e5e7eb; --line-strong: #d1d5db;
        --blue: #2563eb; --blue-soft: #eff6ff;
        --go: #15803d; --go-bg: #f0fdf4; --est: #b45309; --est-bg: #fffbeb; --stop: #b91c1c; --stop-bg: #fef2f2; --info: #1d4ed8; --info-bg: #eff6ff;
        --ring: conic-gradient(from var(--a), #2563eb, #93c5fd, #dbeafe, #93c5fd, #2563eb);
        --sans: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
        --shadow: 0 1px 2px #0f172a0d, 0 4px 16px -6px #0f172a14;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; color-scheme: light; }
      body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.6 var(--sans); -webkit-font-smoothing: antialiased; }
      a { color: var(--blue); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
      .narrow { max-width: 840px; }

      /* Header: brand + search + links, then a project row */
      header.site { border-bottom: 1px solid var(--line); background: #ffffffeb; backdrop-filter: blur(8px); position: sticky; top: 0; z-index: 20; }
      .top { display: flex; align-items: center; gap: 16px; height: 60px; }
      .brand { display: flex; align-items: center; gap: 9px; color: var(--ink); font-weight: 700; letter-spacing: -.01em; white-space: nowrap; }
      .brand:hover { text-decoration: none; }
      .logo { width: 26px; height: 26px; border-radius: 7px; background: var(--ink); display: grid; place-items: center; }
      .top-links { display: flex; gap: 4px; margin-left: auto; }
      .top-links a { color: var(--muted); font-size: 14px; font-weight: 500; padding: 6px 10px; border-radius: 8px; white-space: nowrap; }
      .top-links a:hover, .top-links a[aria-current] { color: var(--ink); background: var(--soft); text-decoration: none; }
      .top .search { width: 260px; }
      .projects { display: flex; justify-content: center; gap: 4px; overflow-x: auto; scrollbar-width: none; padding: 0 0 8px; }
      .projects::-webkit-scrollbar { display: none; }
      .projects a { display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 13px; font-weight: 500; padding: 5px 10px; border-radius: 999px; white-space: nowrap; }
      .projects a:hover, .projects a[aria-current] { color: var(--ink); background: var(--soft); text-decoration: none; }
      .dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
      @media (max-width: 820px) { .top .search { display: none; } }
      @media (max-width: 560px) { .top-links a.opt { display: none; } .projects { justify-content: flex-start; } }

      main { padding: 36px 0 72px; overflow-x: clip; }
      h1 { font-size: clamp(30px, 5.5vw, 52px); line-height: 1.1; letter-spacing: -.035em; margin: 0 0 12px; font-weight: 800; }
      h2 { font-size: 21px; letter-spacing: -.02em; margin: 44px 0 14px; font-weight: 700; }
      .lede { color: var(--muted); font-size: 18px; margin: 0 0 24px; max-width: 62ch; }
      .kicker { font-size: 13px; font-weight: 600; color: var(--muted); margin: 0 0 8px; }
      .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 6px 12px; flex-wrap: wrap; margin: 52px 0 14px; }
      .section-head h2 { margin: 0; }
      .section-head p { margin: 0; color: var(--muted); font-size: 14px; }
      .section-head a { font-size: 14px; font-weight: 500; }

      /* Search */
      @property --a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
      @keyframes spin { to { --a: 360deg; } }
      .search { position: relative; }
      .search-box { position: relative; display: flex; align-items: center; gap: 10px; background: var(--bg); border: 1px solid var(--line-strong);
        border-radius: 12px; padding: 0 12px; height: 40px; transition: transform .25s ease, box-shadow .25s ease, border-color .25s; }
      .search-box::before { content: ""; position: absolute; inset: -2px; border-radius: 14px; padding: 2px; background: var(--ring);
        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
        opacity: 0; transition: opacity .3s; animation: spin 3s linear infinite; pointer-events: none; }
      .search-box:focus-within { border-color: transparent; box-shadow: 0 10px 30px -10px #2563eb40; transform: translateY(-1px); }
      .search-box:focus-within::before { opacity: 1; }
      .search-icon { color: var(--faint); flex: none; transition: color .2s, transform .3s; }
      .search-box:focus-within .search-icon { color: var(--blue); transform: scale(1.1) rotate(-8deg); }
      .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: 15px; color: var(--ink); height: 100%; }
      .search input::placeholder { color: var(--faint); }
      .search input::-webkit-search-cancel-button { display: none; }
      .search kbd { font: 500 12px var(--sans); color: var(--muted); border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 6px; padding: 0 7px; }
      .search.lg .search-box { height: 58px; border-radius: 16px; padding: 0 18px; box-shadow: var(--shadow); }
      .search.lg .search-box::before { border-radius: 18px; }
      .search.lg input { font-size: 17px; }
      .search.lg .search-box:not(:focus-within) { animation: breathe 4s ease-in-out infinite; }
      @keyframes breathe { 50% { box-shadow: 0 1px 2px #0f172a0d, 0 8px 28px -8px #2563eb33; } }
      .search-box { z-index: 1; }
      .peng { position: absolute; right: 34px; bottom: calc(100% - 16px); z-index: 0; transition: transform .35s cubic-bezier(.3,1.6,.5,1); transform-origin: 50% 100%; }
      .search:focus-within .peng { transform: translateY(-6px); }
      .search.puzzled .peng { transform: translateY(-6px) rotate(-10deg); }
      .peng-pupils { transition: transform .12s ease-out; }
      .peng-eyes { transform-origin: 30px 21px; animation: blink 5s infinite; }
      @keyframes blink { 0%, 95%, 100% { transform: scaleY(1); } 97% { transform: scaleY(.1); } }
      .search-results { position: absolute; left: 0; right: 0; top: calc(100% + 8px); z-index: 30; list-style: none; margin: 0; padding: 6px;
        background: var(--bg); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 20px 40px -12px #0f172a2e; max-height: 380px; overflow-y: auto;
        animation: drop .18s ease-out; transform-origin: top; text-align: left; }
      @keyframes drop { from { opacity: 0; transform: translateY(-6px) scale(.98); } }
      .search-results li a { display: flex; align-items: center; gap: 12px; padding: 9px 10px; border-radius: 10px; color: var(--ink);
        animation: rise .25s ease-out backwards; animation-delay: calc(var(--i) * 30ms); }
      @keyframes rise { from { opacity: 0; transform: translateY(4px); } }
      .search-results li a:hover, .search-results li a[aria-selected="true"] { background: var(--soft); text-decoration: none; }
      .search-results .sr-main { flex: 1; min-width: 0; display: grid; }
      .search-results .sr-t { font-weight: 600; font-size: 15px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .search-results .sr-w { font-size: 13px; color: var(--muted); }
      .search-results .sr-head { font-size: 12px; font-weight: 600; color: var(--faint); padding: 6px 10px 4px; }
      .search-results .sr-empty { padding: 14px 10px; color: var(--muted); font-size: 14px; }
      @media (prefers-reduced-motion: reduce) {
        .search-box::before, .search.lg .search-box, .search-results, .search-results li a, .peng-eyes { animation: none !important; }
        .peng { transition: none; }
      }

      /* Shared bits */
      .chip { flex: none; display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; background: var(--soft) !important; color: var(--ink); border: 1px solid var(--line); font-size: 12px; font-weight: 600; }
      .icon { flex: none; display: block; }
      .tile { flex: none; display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; background: var(--soft); border: 1px solid var(--line); color: var(--ink); }
      .tile.sm { width: 30px; height: 30px; border-radius: 8px; }
      .tile.lg { width: 60px; height: 60px; border-radius: 16px; }
      .title-row { display: flex; align-items: center; gap: 16px; margin: 0 0 12px; }
      .title-row h1 { margin: 0; }
      @media (max-width: 560px) { .tile.lg { width: 48px; height: 48px; border-radius: 13px; } .title-row { gap: 12px; } }
      .projects .icon { opacity: .75; }
      .badge { display: inline-block; font-size: 12px; font-weight: 600; padding: 2px 9px; border-radius: 999px; white-space: nowrap; border: 1px solid transparent; }
      .badge { background: var(--soft); color: var(--muted); border-color: var(--line); }
      .badge.go, .badge.released { background: var(--bg); color: var(--ink); border-color: var(--line-strong); }
      .badge.ok, .badge.scheduled, .badge.info { background: var(--blue-soft); color: var(--blue); border-color: #dbeafe; }
      .badge.due { background: var(--blue); color: #fff; border-color: var(--blue); }
      .card { background: var(--bg); border: 1px solid var(--line); border-radius: 14px; padding: 18px 20px; }
      .notice { border: 1px solid var(--line); background: var(--soft); color: var(--ink); border-radius: 12px; padding: 12px 16px; margin: 16px 0; font-size: 15px; }
      .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin: 20px 0; }
      .fact { border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; }
      .fact .k { color: var(--muted); font-size: 13px; }
      .fact .v { font-size: 20px; font-weight: 700; }
      table { border-collapse: collapse; width: 100%; font-size: 15px; }
      th, td { text-align: left; padding: 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
      thead th { font-size: 13px; font-weight: 600; color: var(--muted); }
      .table-scroll { overflow-x: auto; }
      details { border: 1px solid var(--line); border-radius: 12px; padding: 12px 16px; margin: 8px 0; }
      summary { cursor: pointer; font-weight: 600; }
      .crumbs { font-size: 13px; color: var(--muted); margin-bottom: 14px; }
      .crumbs a { color: var(--muted); }
      .meta { color: var(--muted); font-size: 14px; }

      /* Timeline (one per release or project) */
      .line { --line-color: var(--ink); list-style: none; margin: 6px 0 0; padding: 0; display: flex; }
      .stop { flex: 1 1 0; min-width: 0; position: relative; padding-top: 26px; text-align: center; }
      .stop::before { content: ""; position: absolute; top: 9px; left: 0; right: 0; height: 2px; background: var(--line-color); }
      .stop:first-child::before { left: 50%; }
      .stop:last-child::before { right: 50%; }
      .today ~ .stop::before, .today::after { background: repeating-linear-gradient(90deg, var(--line-strong) 0 6px, transparent 6px 11px); }
      .today::before { right: 50%; }
      .today::after { content: ""; position: absolute; top: 9px; left: 50%; right: 0; height: 2px; }
      .stop:last-child.today::after { display: none; }
      .stop .dot { position: absolute; top: 4px; left: 50%; width: 12px; height: 12px; margin-left: -6px; border-radius: 50%; background: var(--bg); border: 2px solid var(--line-strong); z-index: 1; }
      .stop.done .dot { background: var(--line-color); border-color: var(--line-color); }
      .stop.final .dot { border-color: var(--line-color); }
      .today .dot { background: var(--blue); border-color: var(--bg); box-shadow: 0 0 0 3px #2563eb40; animation: pulse 2s ease-out infinite; }
      @keyframes pulse { 50% { box-shadow: 0 0 0 7px #2563eb00; } }
      @media (prefers-reduced-motion: reduce) { .today .dot { animation: none; } }
      .stop .lbl { display: block; font-weight: 600; font-size: 14px; line-height: 1.3; padding: 0 4px; color: var(--ink); }
      .today .lbl { color: var(--blue); }
      .stop .when { display: block; font-size: 12px; color: var(--muted); }
      @media (max-width: 640px) {
        .line { flex-direction: column; }
        .stop { padding: 0 0 16px 28px; text-align: left; }
        .stop::before { top: 0; bottom: 0; left: 5px; right: auto; width: 2px; height: auto; }
        .stop:first-child::before { left: 5px; top: 10px; }
        .stop:last-child::before { right: auto; bottom: auto; height: 10px; }
        .today ~ .stop::before, .today::after { background: repeating-linear-gradient(180deg, var(--line-strong) 0 6px, transparent 6px 11px); }
        .today::before { right: auto; bottom: 50%; }
        .today::after { top: 50%; left: 5px; right: auto; width: 2px; height: auto; bottom: 0; }
        .stop .dot { left: 6px; top: 5px; }
        .stop .lbl { padding: 0; }
      }

      footer.site { border-top: 1px solid var(--line); padding: 28px 0 44px; color: var(--muted); font-size: 14px; }
      footer.site .wrap { display: grid; gap: 6px; }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap top">
        <a class="brand" href="/">
          <span class="logo" aria-hidden="true"><svg viewBox="0 0 32 32" width="18" height="18"><path d="M9 23 22 10M13 10h9v9" stroke="white" stroke-width="3.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          Linux Release Tracker
        </a>
        {!hideSearch && <Search size="sm" />}
        <nav class="top-links" aria-label="Main">
          <a class="opt" href="/#releases">Out now</a>
          <a class="opt" href="/#releases">Coming next</a>
          <a href="/track-record/" aria-current={path.startsWith('/track-record') ? 'page' : undefined}>Track record</a>
        </nav>
      </div>
      <nav class="wrap projects" aria-label="Projects">
        {families.map((f) => (
          <a href={`/${f.id}/`} aria-current={path.startsWith(`/${f.id}/`) ? 'page' : undefined}>
            <Icon id={f.id} size={14} />{short(f)}
          </a>
        ))}
      </nav>
    </header>
    <main><div class="wrap" class:list={{ narrow: !wide }}><slot /></div></main>
    <footer class="site">
      <div class="wrap">
        <span><b>Linux Release Tracker</b> · data checked {formatDay(updated)} against official sources.</span>
        <span>Every date is labelled scheduled (the project published it), predicted (our estimate) or released. Forecasts are never edited afterwards: <a href="/track-record/">see how they did</a>.</span>
        <span><a href="/about/">About and how it works</a> · <a href="/track-record/">Track record</a> · <a href="/sitemap.xml">Sitemap</a></span>
      </div>
    </footer>
    <script is:inline>
      // Countdowns stay correct between rebuilds.
      document.querySelectorAll('[data-countdown]').forEach(function (el) {
        var t = Date.parse(el.getAttribute('data-countdown') + 'T00:00:00Z');
        var n = new Date(); n = Date.UTC(n.getUTCFullYear(), n.getUTCMonth(), n.getUTCDate());
        var d = Math.round((t - n) / 86400000);
        el.textContent = d === 0 ? 'today' : d === 1 ? 'tomorrow' : d > 0 ? 'in ' + d + ' days' : -d + ' days ago';
      });

      // Search: filter the inline index, keyboard support, typewriter placeholder.
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var boxes = [].slice.call(document.querySelectorAll('[data-search]'));
      boxes.forEach(function (box) {
        var input = box.querySelector('input');
        var list = box.querySelector('.search-results');
        var index = JSON.parse(box.querySelector('[data-index]').textContent);
        var sel = -1;
        function esc(s) { return s.replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
        function render() {
          var q = input.value.trim().toLowerCase();
          var words = q.split(/\s+/).filter(Boolean);
          var hits = q ? index.filter(function (r) { var hay = r.k + ' ' + r.t.toLowerCase(); return words.every(function (w) { return hay.indexOf(w) >= 0; }); })
                       : index.filter(function (r) { return r.n; });
          sel = -1;
          var html = q ? '' : '<li class="sr-head">Coming up next</li>';
          html += hits.slice(0, 8).map(function (r, i) {
            return '<li><a href="' + r.u + '" style="--i:' + i + '" role="option"><span class="chip"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="currentColor" d="' + r.p + '"/></svg>' +
              '</span><span class="sr-main"><span class="sr-t">' + esc(r.t) + '</span><span class="sr-w">' + esc(r.w) +
              '</span></span><span class="badge ' + r.tone + '">' + esc(r.s) + '</span></a></li>';
          }).join('');
          if (q && !hits.length) html = '<li class="sr-empty">No release matches “' + esc(input.value) + '”. We are adding more Linux software every week.</li>';
          list.innerHTML = html;
          box.classList.toggle('puzzled', Boolean(q) && !hits.length);
          list.hidden = false;
          input.setAttribute('aria-expanded', 'true');
        }
        function close() { list.hidden = true; input.setAttribute('aria-expanded', 'false'); }
        function move(d) {
          var links = list.querySelectorAll('a');
          if (!links.length) return;
          sel = (sel + d + links.length) % links.length;
          links.forEach(function (a, i) { a.setAttribute('aria-selected', i === sel ? 'true' : 'false'); });
          links[sel].scrollIntoView({ block: 'nearest' });
        }
        input.addEventListener('focus', render);
        input.addEventListener('input', render);
        input.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
          else if (e.key === 'Enter') { var a = list.querySelectorAll('a')[sel < 0 ? 0 : sel]; if (a) location.href = a.href; }
          else if (e.key === 'Escape') { close(); input.blur(); }
        });
        document.addEventListener('click', function (e) { if (!box.contains(e.target)) close(); });

        // Typewriter placeholder on the big search only.
        if (box.classList.contains('lg') && !reduce) {
          var ex = JSON.parse(input.dataset.examples), base = 'Search a release, like ', w = 0, c = 0, del = false;
          (function type() {
            var word = ex[w];
            if (document.activeElement !== input && !input.value) input.placeholder = base + word.slice(0, c) + (c % 2 ? '|' : ' ');
            if (!del && c < word.length) c++;
            else if (!del) { del = true; return setTimeout(type, 1600); }
            else if (c > 0) c--;
            else { del = false; w = (w + 1) % ex.length; }
            setTimeout(type, del ? 40 : 90);
          })();
        }
      });
      // The penguin's eyes follow the mouse, and look down at the box while typing.
      var peng = document.querySelector('[data-peng]');
      if (peng && !reduce) {
        var pupils = peng.querySelector('.peng-pupils'), pin = document.querySelector('.search.lg input');
        function look(x, y) {
          var r = peng.getBoundingClientRect(), dx = x - (r.left + r.width / 2), dy = y - (r.top + r.height * 0.35);
          var d = Math.max(1, Math.hypot(dx, dy)), k = Math.min(1.8, d / 60);
          pupils.style.transform = 'translate(' + (dx / d * k).toFixed(2) + 'px,' + (dy / d * k).toFixed(2) + 'px)';
        }
        document.addEventListener('mousemove', function (e) { if (document.activeElement !== pin) look(e.clientX, e.clientY); });
        pin.addEventListener('input', function () { pupils.style.transform = 'translate(-1.4px,1.6px)'; });
      }
      // "/" jumps to the most prominent search box.
      document.addEventListener('keydown', function (e) {
        if (e.key !== '/' || /input|textarea/i.test(document.activeElement.tagName)) return;
        var target = document.querySelector('.search.lg input') || document.querySelector('.search input');
        if (target && target.offsetParent) { e.preventDefault(); target.focus(); }
      });
    </script>
  </body>
</html>
